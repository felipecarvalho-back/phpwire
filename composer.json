{
    "name": "felipecarvalho-back/phpwire",
    "description": "Biblioteca PHP leve e reativa inspirada no Livewire para criar componentes dinamicos sem escrever JavaScript.",
    "type": "library",
    "homepage": "https://github.com/felipecarvalho-back/phpwire",
    "keywords": [
        "php",
        "livewire",
        "reactive",
        "components",
        "phpwire"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe"
        }
    ],
    "require": {
        "php": ">=8.1",
        "eftec/bladeone": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "PhpWire\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8"
    }
}
